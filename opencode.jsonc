{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "petstore": {
      "type": "local",
      "command": ["node", "generated/petstore-mcp/index.js"],
      "enabled": true,
      "environment": {
        "BASE_URL": "https://petstore.swagger.io/v2"
      }
    },
    "jsonplaceholder": {
      "type": "local",
      "command": ["node", "generated/jsonplaceholder-mcp/index.js"],
      "enabled": true,
      "environment": {
        "BASE_URL": "https://jsonplaceholder.typicode.com"
      }
    }
  },
  "instructions": ["README.md"]
}
