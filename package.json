{
  "name": "openapi-mcp-generator",
  "version": "0.1.0",
  "description": "Generate a standalone Model Context Protocol (MCP) server from any OpenAPI 3.0/3.1 spec. CLI + TypeScript library.",
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "model-context-protocol",
    "codegen",
    "cli",
    "ai",
    "claude"
  ],
  "author": "openapi-mcp-generator",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openapi-mcp-generator": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"tests/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^12.1.0",
    "undici": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
